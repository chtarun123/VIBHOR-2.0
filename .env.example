# ── VIBHOR environment ─────────────────────────────────────────
# Copy to .env and adjust. The app runs with sensible defaults without one.

# HTTP port (default 5000)
PORT=5000

# Session signing secret — CHANGE THIS in production
SESSION_SECRET=change-me-to-a-long-random-string

# Environment: development | production
NODE_ENV=development

# Override the SQLite database file location (default database/vibhor.sqlite)
# DB_PATH=/absolute/path/to/vibhor.sqlite

# ── Future LLM integration (VIBHOR AI Guide) ───────────────────
# The AI Guide runs on the local heritage knowledge base and needs NO key.
# To plug in a real LLM later, set these on the SERVER ONLY.
# Keys are never sent to the browser (see server/routes/misc.js).
# AI_LLM_ENDPOINT=https://api.example.com/v1/chat
# AI_LLM_API_KEY=

# YouTube search service used by detail pages (server-side proxy optional)
# YT_API_BASE=https://ytapis.djalokyt27.workers.dev/
